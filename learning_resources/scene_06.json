{"scene_id":"scene_06","scene_name":"中文命名实体标注","version":"2026-09-10-compact","basic_learning":{"resource_id":"s6_basic_learning","title":"中文命名实体标注基础学习","intro":"进入初次诊断前，请先完成本场景基础学习。学习完成后进入固定5题初次诊断。","learning_objectives":{"knowledge":"掌握命名实体、实体边界、实体类别、BIO/BIOES及嵌套实体的基本规范。","skill":"能够完成中文实体识别、边界定位、类别判断、序列标注和复杂实体标注。","literacy":"形成规范化文本标注、边界一致性和质量复核意识。"},"task_steps":[{"order":1,"title":"NER基础概念学习","duration":"10分钟","content":"认识命名实体及人名、机构名、地点等常见类别。","key_point":"掌握实体识别基本概念"},{"order":2,"title":"实体识别与边界判断","duration":"15分钟","content":"学习实体起止位置和连续文本边界的判断。","key_point":"减少漏标与边界偏差"},{"order":3,"title":"实体类型学习","duration":"10分钟","content":"根据上下文判断实体所属类别。","key_point":"提高类型分类准确率"},{"order":4,"title":"BIO/BIOES规则学习","duration":"15分钟","content":"学习B、I、O及扩展标签的序列编码规则。","key_point":"掌握序列标注规范"},{"order":5,"title":"嵌套实体学习","duration":"15分钟","content":"学习重叠、包含和复杂实体结构的标注。","key_point":"处理复杂实体情况"}],"resources":[{"title":"Hugging Face：Token Classification / NER","type":"document","description":"学习NER与Token Classification的基本概念和流程。","url":"https://huggingface.co/docs/transformers/main/tasks/token_classification","enabled":true},{"title":"Label Studio：NER标注模板","type":"document","description":"学习文本实体区间选择与类别标注。","url":"https://labelstud.io/templates/named_entity.html","enabled":true},{"title":"Label Studio：OCR+BIO示例","type":"document","description":"辅助理解BIO格式与序列标注的实际应用。","url":"https://labelstud.io/templates/ocr_invoices_pre_ner_bio_format","enabled":true}],"completion_text":"完成基础学习，进入初次诊断"},"skill_display_map":{"s6_recognition":"文本实体识别能力","s6_boundary":"标注边界修正","s6_type":"文本标注类别规范","s6_nested":"复杂实体标注能力","s6_bio":"序列标注规范"},"personalized_resources":[{"resource_id":"s6_recognition_job_basic","kp_id":"s6_recognition","goal_type":"job","level":"basic","title":"文本实体识别能力 · 岗位技能提升 · 基础强化","url":"https://huggingface.co/docs/transformers/main/tasks/token_classification","enabled":true},{"resource_id":"s6_recognition_job_practice","kp_id":"s6_recognition","goal_type":"job","level":"practice","ti