{"scene_id":"scene_07","scene_name":"商场小票关键信息抽取","version":"2026-09-10-compact","basic_learning":{"resource_id":"s07_basic_learning","title":"商场小票关键信息抽取基础学习","intro":"进入初次诊断前，请先完成本场景基础学习。学习完成后进入固定5题初次诊断。","learning_objectives":{"knowledge":"掌握OCR、票据字段类别、商品明细、金额字段和字段映射的基本规范。","skill":"能够从小票图像或OCR文本中抽取商户、日期、金额和商品等结构化信息。","literacy":"形成文档结构化抽取、金额核验和结果复盘意识。"},"task_steps":[{"order":1,"title":"OCR基础学习","duration":"10分钟","content":"了解图像文字识别与OCR文本校对的基本流程。","key_point":"理解OCR输入与输出"},{"order":2,"title":"票据字段类别学习","duration":"10分钟","content":"认识商户、日期、总额、税额、商品等常见字段。","key_point":"掌握字段类型"},{"order":3,"title":"商品明细抽取","duration":"15分钟","content":"学习商品名称、数量、单价等结构化抽取。","key_point":"准确解析items"},{"order":4,"title":"金额信息校验","duration":"10分钟","content":"检查总额、税额和商品金额之间的关系。","key_point":"降低金额字段错误"},{"order":5,"title":"字段映射与复核","duration":"10分钟","content":"把OCR片段映射到目标字段并检查遗漏和错配。","key_point":"形成结构化抽取闭环"}],"resources":[{"title":"Label Studio：OCR标注模板","type":"document","description":"学习图像文字区域识别与文本转写。","url":"https://labelstud.io/templates/optical_character_recognition","enabled":true},{"title":"Label Studio：文档OCR用例","type":"document","description":"了解文档图像中的区域标注、转写与人工复核。","url":"https://labelstud.io/templates/use-cases/ocr_docs.html","enabled":true},{"title":"Label Studio：PDF OCR模板","type":"document","description":"了解文档字段区域、OCR文本和错误校正流程。","url":"https://labelstud.io/templates/pdf_ocr","enabled":true}],"completion_text":"完成基础学习，进入初次诊断"},"skill_display_map":{"s7_ocr":"OCR文档信息识别","s7_field_type":"票据字段类别规范","s7_items":"商品信息结构化抽取","s7_amount":"金额信息校验","s7_mapping":"字段映射与结果复盘"},"personalized_resources":[{"resource_id":"s7_ocr_job_basic","kp_id":"s7_ocr","goal_type":"job","level":"basic","title":"OCR文档信息识别 · 岗位技能提升 · 基础强化","url":"https://labelstud.io/templates/optical_character_recognition","enabled":true},{"resource_id":"s7_ocr_job_practice","kp_id":"s7_ocr","goal_type":"job","level":"practice","title":"OCR文档信息识别 · 岗位技能提升 · 专项巩固","url":"https://labelstud.io/templates/optical_character_recognition